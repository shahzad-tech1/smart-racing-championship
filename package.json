{
  "name": "smart-racing-championship",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Smart Racing Championship — a 2D top-down racing game demonstrating 12 DAA algorithm families.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "measure-refs": "tsx src/experiments/measure-refs.ts"
  },
  "dependencies": {
    "chart.js": "^4.4.6"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@vitest/ui": "^2.1.4",
    "eslint": "^9.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
